      "technologies_used": ["Servlet", "JSP", "JSTL", "JDBC", "Filter", "Listener", "MVC"]
    },
    {
      "name": "在线商城系统",
      "difficulty": 5,
      "technologies_used": ["完整JavaWeb技术栈", "购物车(Session)", "权限控制(Filter)", "数据统计(Listener)"]
    }
  ]
}